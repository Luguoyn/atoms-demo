# Copy to .env.local and fill in. Never commit real keys.
#
# Any OpenAI-compatible chat-completions endpoint works.
# Example A — OpenCode Go gateway (DeepSeek V4.1 Flash; reasoning + tool calling):
#   LLM_BASE_URL=https://opencode.ai/inference/go/openai/v1
#   LLM_MODEL=deepseek-v4.1-flash
#   LLM_API_KEY=oc_sk_xxx
# Example B — DeepSeek direct:
#   LLM_BASE_URL=https://api.deepseek.com
#   LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_API_KEY=

# Optional: force the offline mock agent (no LLM calls, deterministic demo).
# Accepts 1/true/yes/on. When set, the server stops spending its own key but a
# user-provided BYOK key still works (useful for public demo deployments).
MOCK_LLM=0

# ---- Agent time budgets (milliseconds) -------------------------------------
# Total wall-clock budget for one agent run (planning + coding + validation + 1 repair round).
# Clamped to 30s..900s. Lower it to ~55000 when the host enforces a 60s function limit
# (e.g. Vercel Hobby without Fluid Compute), otherwise that host kills the request mid-stream.
AGENT_BUDGET_MS=300000
# Per-completion timeout for a single LLM request. Clamped to 15s..600s.
LLM_REQUEST_TIMEOUT_MS=180000
# Abort a streaming completion if no bytes arrive for this long. Clamped to 10s..300s.
LLM_IDLE_TIMEOUT_MS=60000

# ---- Output token caps ------------------------------------------------------
# Reasoning models (e.g. deepseek-v4.1-flash) spend part of the budget on hidden
# reasoning tokens, so keep headroom above the visible file size.
# Coding turn cap (clamped 1000..32000). Default 12000.
LLM_CODING_MAX_TOKENS=12000
# Planning turn cap (clamped 500..16000). Default 3000.
LLM_PLAN_MAX_TOKENS=3000
# Fallback cap for completions without an explicit budget (clamped 256..32000).
LLM_MAX_TOKENS=8000

# ---- Client identity / gateway headers (optional) ---------------------------
# Some gateways (e.g. OpenCode Go) identify coding agents by User-Agent and route
# prompt caching by a stable `x-opencode-session` header. The app sends both
# automatically for opencode.ai endpoints; override the UA if you like.
# LLM_USER_AGENT=atoms-demo/0.1 (coding-agent; +https://github.com/Luguoyn/atoms-demo)
# Extra headers as JSON object, applied to every model request:
# LLM_EXTRA_HEADERS={"x-api-key":"...","x-org":"acme"}

# ---- Public demo guard rails (server-key generations only) ------------------
# Per-IP hourly quota for generations that spend the server's own key.
RATE_LIMIT_PER_HOUR=12
# Max concurrent server-key generations; extra requests get a friendly 429.
RATE_LIMIT_CONCURRENT=2
# Per-IP hourly cap for POST /api/prompt/enhance (independent from generations).
PROMPT_ENHANCE_PER_HOUR=30
# Output-token budget for POST /api/prompt/enhance (clamped 800..4000). Default 2400.
PROMPT_ENHANCE_MAX_TOKENS=2400
